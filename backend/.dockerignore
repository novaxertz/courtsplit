# Keep the build context small and the image clean. Anything listed here is
# never sent to the daemon, so it cannot be copied into a layer by accident.

node_modules
npm-debug.log*

# Secrets must come from the environment or a Secret object, never a layer.
.env
.env.*
!.env.example

# Not needed at runtime.
#
# NOTE: `scripts/` is deliberately NOT excluded. The Kubernetes CronJob runs
# scripts/expiry-sweep.js out of this image, so excluding it produced a
# MODULE_NOT_FOUND loop on every scheduled run.
tests
docs
deploy
terraform
*.md
Dockerfile
.dockerignore
docker-compose*.yml

.git
.gitignore
.vscode
.idea
coverage
