{
  "name": "courtsplit-api",
  "version": "1.0.0",
  "description": "Split-payment court booking API - book a slot, invite players, everyone pays their share",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:mongo": "node scripts/test-engine.mjs mongo",
    "test:postgres": "node scripts/test-engine.mjs postgres",
    "test:both": "npm run test:mongo && npm run test:postgres",
    "pg:up": "docker compose up -d",
    "pg:down": "docker compose down"
  },
  "keywords": [
    "express",
    "mongodb",
    "stripe",
    "payments",
    "booking",
    "rest-api"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "pg": "^8.22.0"
  },
  "optionalDependencies": {
    "stripe": "^16.2.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "mongodb-memory-server@11.2.0": true
  }
}
