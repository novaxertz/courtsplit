# Copy to .env and fill in your own values. Never commit the real .env.

# MongoDB connection string (Atlas or local).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/courtsplit?retryWrites=true&w=majority

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# "mock" runs without any payment keys, which is enough to exercise the whole
# booking flow. Switch to "stripe" to use the real Stripe test API.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Minutes a group has to fully fund a booking before it expires.
FUNDING_WINDOW_MINUTES=60

# Cancellation policy.
FREE_CANCELLATION_HOURS=24
LATE_CANCELLATION_REFUND_PERCENT=50
